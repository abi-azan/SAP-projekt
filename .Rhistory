select(award, imdb_rating, tomato_rating, audience_rating) %>%
pivot_longer(cols = -award, names_to = "rating_type", values_to = "value")
ggplot(ratings_long, aes(x = award, y = value, fill = award)) +
geom_boxplot() +
facet_wrap(~rating_type, scales = "free") +
theme_minimal() +
labs(title = "Usporedba ocjena: Pobjednici vs. Nominirani",
y = "Ocjena", x = "Status nagrade")
# Testiranje razlika za Tomatometer i Audience rating
# Budući da su podaci često ne-normalni, koristimo Wilcoxon test
wilcox_tomato <- wilcox.test(tomato_rating ~ award, data = oscars_dataset2)
wilcox_audience <- wilcox.test(audience_rating ~ award, data = oscars_dataset2)
print(paste("Wilcoxon p-vrijednost za Tomato Rating:", wilcox_tomato$p.value))
print(paste("Wilcoxon p-vrijednost za Audience Rating:", wilcox_audience$p.value))
# Usporedba broja IMDb glasova (koristimo logaritamsku skalu zbog velikih razlika)
ggplot(oscars_dataset2, aes(x = award, y = imdb_votes, fill = award)) +
geom_boxplot() +
scale_y_log10() +
theme_minimal() +
labs(title = "Usporedba broja IMDb glasova (Log skala)",
y = "Broj glasova (log)", x = "Status nagrade")
# Statistički test za popularnost
wilcox_votes <- wilcox.test(imdb_votes ~ award, data = oscars_dataset2)
print(paste("Wilcoxon p-vrijednost za broj IMDb glasova:", wilcox_votes$p.value))
ggplot(oscars_dataset2, aes(x = award, y = lenght, fill = award)) +
geom_boxplot() +
theme_classic() +
labs(title = "Trajanje filma: Pobjednici vs. Nominirani",
y = "Minuta", x = "Status nagrade")
# Testiranje razlike u trajanju
wilcox_length <- wilcox.test(lenght ~ award, data = oscars_dataset2)
summary_length <- oscars_dataset2 %>%
group_by(award) %>%
summarise(Median_Length = median(lenght, na.rm = TRUE))
print(summary_length)
print(paste("Wilcoxon p-vrijednost za trajanje filma:", wilcox_length$p.value))
ggplot(oscars_dataset2, aes(x = lenght, y = imdb_rating, color = award)) +
geom_point(alpha = 0.6) +
geom_smooth(method = "lm", se = FALSE) +
theme_minimal() +
labs(title = "Odnos trajanja, ocjene i pobjede",
x = "Trajanje (min)", y = "IMDb ocjena")
ggplot(imdb_ocjena_starost, aes(x = y_release, y = imdb_rating)) +
geom_point(alpha = 0.5) +  # alpha makes points semi-transparent to see density
geom_smooth(method = "lm", color = "blue", se = TRUE) + # "lm" = linear model
labs(title = "Relationship Between Movie Age and IMDb Rating",
x = "Release Year",
y = "IMDb Rating") +
theme_minimal()
knitr::opts_chunk$set(echo = TRUE)
library(dplyr)
library(readr)
library(stringr)
library(hflights)
library(tidyr)
library(lubridate)
library(ggplot2)
library(tidyverse)
library(ggpubr)
oscars_dataset <- read_delim("oscars_dataset.csv", delim = ";", escape_double = FALSE, trim_ws = TRUE)
oscars_dataset2 <- oscars_dataset
colnames(oscars_dataset2) <- c("num","film","o_year","producer","award","y_release","lenght","genres","main_genre","sub_genre","imdb_rating","imdb_votes","c_rating","directors","original_release_date","prod_company","tomato_rating","tomato_count","audience_rating","audience_count")
summary(oscars_dataset)
wins_by_genre <- oscars_dataset %>%
filter(Award == "Winner") %>%
count(`Main Genre`, name = "Wins")
genre_count <- oscars_dataset %>%
count(`Main Genre`, name = "count")
barplot(wins_by_genre$Wins, xlab = "Genre", ylab = "Wins", main ="Wins by Genre",names.arg = wins_by_genre$`Main.Genre`,col = "light blue")
barplot(genre_count$count, xlab = "Genre", ylab = "count", main ="Genre Count",names.arg = genre_count$`Main Genre`,width = 20)
prvo_pitanje <- chisq.test(wins_by_genre$Wins)
print(prvo_pitanje)
#Jesu li neki žanrovi u prosjeku dulji od ostalih?
duration_by_genre <- oscars_dataset %>%
group_by(`Main Genre`) %>%
summarise(
Avg_Duration = mean(`Movie Time`, na.rm = TRUE),
Movie_Count = n()
) %>%
arrange(desc(Avg_Duration))
print(duration_by_genre)
par(mar=c(10, 5, 4, 2))
boxplot(oscars_dataset$`Movie Time` ~ oscars_dataset$`Main Genre`,
main = "Trajanje filmova po žanrovima",
ylab = "Trajanje (min)",
col = "light blue",
las = 2,
cex.axis = 0.8)
mean.imdb.rating <- mean(oscars_dataset2$imdb_rating)
mean.tomato.rating <- oscars_dataset2$tomato_rating %>% na.omit() %>% mean()
mean.audience.rating <- oscars_dataset2$audience_rating %>%  na.omit() %>% mean()
mean.year <- mean(oscars_dataset2$y_release)
imdb_ocjena_starost <- select(oscars_dataset2,y_release,imdb_rating)
fit.imdb = lm(imdb_rating~y_release,data=imdb_ocjena_starost)
plot(imdb_ocjena_starost$y_release,imdb_ocjena_starost$imdb_rating,main = "IMDb Rating -Release Year",
xlab = "Year of Release",
ylab = "IMDB Rating",
pch = 19,
col = "blue")
#lines(imdb_ocjena_starost$y_release,fit.imdb$fitted.values,col='red')
abline(fit.imdb, col = "red", lwd = 2)
#raspodjela rezidiuala
hist(fit.imdb$residuals)
#studentova standardizacija reziduala
hist(rstandard(fit.imdb))
#iscitavanje podataka uključujući prilagođeni R^2
summary(fit.imdb)
#korelacije
cor(oscars_dataset2$y_release,oscars_dataset2$imdb_rating)
fit.tomato = lm(tomato_rating~y_release,data=oscars_dataset2)
plot(oscars_dataset2$y_release,oscars_dataset2$tomato_rating,main = "Tomato Rating -Release Year",
xlab = "Year of Release",
ylab = "Tomatometer Rating",
pch = 19,
col = "tomato")
abline(fit.tomato, col = "green", lwd = 2)
hist(fit.tomato$residuals)
hist(rstandard(fit.tomato))
summary(fit.tomato)
fit.audience = lm(audience_rating~y_release,data=oscars_dataset2)
plot(oscars_dataset2$y_release,oscars_dataset2$audience_rating,main = "Audience Rating -Release Year",
xlab = "Year of Release",
ylab = "Audience Rating",
pch = 19,
col = "black")
abline(fit.audience, col = "red", lwd = 2)
hist(fit.audience$residuals)
hist(rstandard(fit.audience))
summary(fit.audience)
knitr::opts_chunk$set(echo = TRUE)
